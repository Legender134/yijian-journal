{
  "name": "yijian-journal",
  "productName": "逸剑手札",
  "version": "1.12.50",
  "description": "逸剑风云决个人桌面助手：原生自动存读档、历史时间线、任务地点、图鉴与备料",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "node scripts/build-window-helper.cjs && electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "node scripts/package.cjs",
    "smoke": "node scripts/smoke.cjs",
    "format": "prettier --write \"src/**/*.{cjs,js,css,html}\" \"scripts/*.cjs\" \"tests/*.cjs\"",
    "test:package": "node scripts/packaged-regression.cjs",
    "electron:install": "node node_modules/electron/install.js",
    "release:zip": "node scripts/release-zip.cjs",
    "build:window": "node scripts/build-window-helper.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "sharp": "0.35.4"
  },
  "author": "Legender134",
  "repository": {
    "type": "git",
    "url": "https://github.com/Legender134/yijian-journal.git"
  },
  "homepage": "https://github.com/Legender134/yijian-journal#readme",
  "bugs": {
    "url": "https://github.com/Legender134/yijian-journal/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
